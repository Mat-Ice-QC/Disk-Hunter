# Auto detect text files and perform LF normalization
* text=auto

# Force LF line endings for scripts and Docker files to prevent container issues
*.sh text eol=lf
Dockerfile text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
