# Network Settings
# Set IP addresses allowed to access the app. Use '*' for all.
# Example: ALLOWED_IPS=192.168.1.0/24, 10.0.0.1
ALLOWED_IPS=*

# HTTPS Settings
# Provide absolute paths to your SSL certificate and key to enable HTTPS.
# Ensure the paths exist on your system. Common paths like /etc/ssl and /etc/letsencrypt are mounted.
# Example: HTTPS_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
# Example: HTTPS_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=

# Feature Toggles (Enable/Disable Modules)
# Set to 'false' to completely disable the module and hide it from the UI.

# Enables the secure disk shredding utility (nwipe) and its associated UI for data destruction.
ENABLE_SHREDDER=true

# Enables the drive speed testing module (fio) and its history tracking.
ENABLE_SPEEDTEST=true

# Enables the ISO downloader and writer utility for creating bootable drives.
ENABLE_ISOWRITER=true

# Enables the S.M.A.R.T diagnostics interface for testing and viewing drive health.
ENABLE_SMARTCTL=true

# Enables the Data Management module, which provides file browsing and log management capabilities.
ENABLE_DATA_MANAGEMENT=true

# Enables the network share functionality to export disks over the network.
ENABLE_NETWORK_SHARE=true

# When true, users can clear audit logs, test histories, and delete raw data files via the UI.
# Set to 'false' to enforce an append-only audit trail and hide all deletion buttons.
ENABLE_DELETE_HISTORY=true

# --- Directory & File Paths ---
# Use these variables to customize where the application stores data on the HOST machine.
# WARNING: If you change the file paths (e.g. HISTORY_FILE), you MUST manually create the empty file
# on the host (using 'touch') before running docker-compose, otherwise Docker will create it as a directory!
DATA_DIR=./data
REPORTS_DIR=./data/reports
HISTORY_FILE=./data/wipe_history.json
SMARTCTL_HISTORY_FILE=./data/smartctl_history.json
SPEEDTEST_HISTORY_FILE=./data/speedtest_history.json
IMAGES_DIR=./data/images
DRIVES_DIR=./data/images/drives
LOGO_PATH=./data/images/logo.png
ISO_DIR=./data/isos
